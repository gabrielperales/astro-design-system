---
import MainLayout from '../../layouts/MainLayout.astro';
import { COLORS } from '../../design.config'
---

<MainLayout>
    <h1>Colors</h1>

    <div class="component-preview">
      <div class="flex flex-col gap-4">
        {Object.entries(COLORS).map(([colorName, colorShades]) => (
          <div class="mb-8">
            <h3 class="text-lg font-semibold mb-4 capitalize">{colorName}</h3>
            <div class="grid grid-cols-10 gap-2">
              {colorShades.map(({name, value}) => (
                <div class="text-center">
                  <div class="w-16 h-16 rounded-md border border-gray-200" style={`background-color: ${value}`}></div>
                  <div class="text-xs mt-1 font-mono">{name}</div>
                  <div class="text-xs text-gray-500 font-mono">{value}</div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
</MainLayout>
